on post-fs-data
    mkdir /debug_ramdisk 0755
    mount tmpfs tmpfs /debug_ramdisk mode=0755

    mkdir /debug_ramdisk/.magisk 0700
    mkdir /debug_ramdisk/.magisk/device 0755
    mkdir /debug_ramdisk/.magisk/block 0700
    mkdir /debug_ramdisk/.magisk/mirror 0700
    mkdir /debug_ramdisk/.magisk/worker 0755
    mkdir /debug_ramdisk/.magisk/preinit 0700

    copy /system/etc/magisk/magisk64 /debug_ramdisk/magisk64
    copy /system/etc/magisk/magisk32 /debug_ramdisk/magisk32
    copy /system/etc/magisk/magiskinit /debug_ramdisk/magiskinit
    copy /system/etc/magisk/magiskboot /debug_ramdisk/magiskboot
    copy /system/etc/magisk/busybox /debug_ramdisk/busybox
    copy /system/etc/magisk/stub.apk.bin /debug_ramdisk/stub.apk
    copy /system/etc/magisk/util_functions.sh /debug_ramdisk/util_functions.sh
    copy /system/etc/magisk/magisk-ramdisk.img /debug_ramdisk/magisk-ramdisk.img

    # Empty rule file so policy load doesn't hard-fail
    copy /system/etc/magisk/sepolicy.rule /debug_ramdisk/sepolicy.rule
    
    mkdir /data/adb/bin 0755
    symlink /debug_ramdisk/su /data/adb/bin/su
    symlink /debug_ramdisk/magisk /data/adb/bin/magisk

    symlink /debug_ramdisk/magisk64 /debug_ramdisk/magisk
    symlink /debug_ramdisk/magisk64 /debug_ramdisk/su
    symlink /debug_ramdisk/magiskinit /debug_ramdisk/magiskpolicy
    symlink /debug_ramdisk/magisk64 /debug_ramdisk/resetprop

    chmod 0755 /debug_ramdisk/magisk64
    chmod 0755 /debug_ramdisk/magisk32
    chmod 0755 /debug_ramdisk/magiskinit
    chmod 0755 /debug_ramdisk/magiskboot
    chmod 0755 /debug_ramdisk/busybox
    chmod 0644 /debug_ramdisk/stub.apk
    chmod 0644 /debug_ramdisk/util_functions.sh
    chmod 0644 /debug_ramdisk/sepolicy.rule

    # Make socket/device accessible early
    chmod 755 /debug_ramdisk/.magisk
    chmod 755 /debug_ramdisk/.magisk/device

    start magisk_policy_load
    start magisk_post_fs_data
    
    mkdir /data/adb/magisk 0755
    write /data/adb/magisk/.installed 1

    wait /dev/.magisk_unblock 40
    rm /dev/.magisk_unblock

service magisk_policy_load /debug_ramdisk/magiskpolicy --live --apply /debug_ramdisk/sepolicy.rule
    user root
    oneshot
    seclabel u:r:magisk:s0

service magisk_post_fs_data /debug_ramdisk/magisk --post-fs-data
    user root
    oneshot
    seclabel u:r:magisk:s0

service magisk_service /debug_ramdisk/magisk --service
    class late_start
    user root
    oneshot
    seclabel u:r:magisk:s0

on property:sys.boot_completed=1
    start magisk_boot_complete

service magisk_boot_complete /debug_ramdisk/magisk --boot-complete
    user root
    oneshot
    seclabel u:r:magisk:s0
